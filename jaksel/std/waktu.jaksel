// Modul standar waktu: pembantu tanggal & jam, bestie.
// Pakai: collab "std/waktu"
talent sekarang() {
    balikin tanggal("%d/%m/%Y %H:%M:%S")
}

talent hari_ini() {
    balikin tanggal("%d/%m/%Y")
}

talent jam_sekarang() {
    balikin tanggal("%H:%M:%S")
}

talent nama_hari() {
    // "Senin".."Minggu" berdasarkan tanggal sekarang
    bestie kode = tanggal("%w")
    bestie hari = ["Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"]

    balikin hari[angka(kode)]
}

talent nama_bulan() {
    bestie kode = angka(tanggal("%m"))
    bestie bulan = ["", "Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"]

    balikin bulan[kode]
}

talent tanggal_cantik() {
    // "Rabu, 30 September 2026"
    balikin nama_hari() + ", " + tanggal("%d") + " " + nama_bulan() + " " + tanggal("%Y")
}

talent stopwatch(talent_kerja) {
    // ukur berapa detik talent_kerja() jalan
    bestie mulai = waktu()
    talent_kerja()
    balikin waktu() - mulai
}
